@model ReservationAddViewModel

@if(ViewData["ErrorMessage"] != null){
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}

<form method="post" asp-asp-controller="Reservation"
asp-action="Add">
   <div asp-validation-summary="All" class="text-danger"></div>
   <input type="hidden" asp-for="Reservations.Id"/>
   <input type="hidden" asp-for="Reservations.RestaurantId"/>
   <div class="mb-3">
       <label asp-for="Reservations.date" class="form-label"></label>
       <input asp-for="Reservations.date" type="datetime-local" class="form-control"
       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"/>
       <span asp-validation-for="Reservations.date" class="text-danger"></span>
    </div>

<input type="submit" value="Reserve table" class="btn btn-primary">
</form>
